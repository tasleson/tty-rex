[Desktop Entry]
Name=tty-rex
Comment=A Rust port of the Ptyxis terminal
Exec=@bindir@/tty-rex
Icon=io.github.tasleson.TtyRex
DBusActivatable=true
StartupNotify=true
Terminal=false
Type=Application
Categories=GNOME;GTK;System;TerminalEmulator;
GenericName=Terminal
Keywords=terminal;prompt;tty-rex;ptyxis;shell;command;commandline;cmd;cli;console;
Actions=new-window;new-tab;preferences;
X-ExecArg=--
X-TerminalArgTitle=--title
X-TerminalArgDir=--working-directory
X-KDE-AuthorizeAction=shell_access

[Desktop Action new-window]
Name=New Window
Exec=@bindir@/tty-rex --new-window

[Desktop Action new-tab]
Name=New Tab
Exec=@bindir@/tty-rex --tab

[Desktop Action preferences]
Name=Preferences
Exec=@bindir@/tty-rex --preferences
